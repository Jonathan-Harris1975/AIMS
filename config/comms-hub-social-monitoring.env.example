# AIMS Comms Hub - full three-channel social monitoring profile
# Apply these values in Koyeb using the real existing secrets.
# This profile enables Facebook + Instagram through the Meta family and YouTube
# comments through the Video family. YouTube private DMs are not part of this
# adapter. Outbound actions stay blocked until monitor-only is deliberately disabled.

COMMS_HUB_ENABLED=true
COMMS_HUB_ZERNIO_META_ENABLED=true
COMMS_HUB_ZERNIO_VIDEO_ENABLED=true
COMMS_HUB_ZERNIO_POLL_ENABLED=true
COMMS_HUB_SOCIAL_MONITOR_ONLY=true
COMMS_HUB_ZERNIO_POLL_MS=120000
COMMS_HUB_ZERNIO_POLL_LEASE_MS=180000
COMMS_HUB_ZERNIO_POLL_BATCH_SIZE=25
COMMS_HUB_ZERNIO_POLL_OVERLAP_MS=7200000
COMMS_HUB_ZERNIO_MAX_MESSAGE_PAGES=5
COMMS_HUB_ZERNIO_MAX_COMMENT_PAGES=5

# Provider and callback values. Keep secrets in Koyeb only.
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
ZERNIO_META_API_KEY=
ZERNIO_META_WEBHOOK_SECRET=
ZERNIO_VIDEO_API_KEY=
ZERNIO_VIDEO_WEBHOOK_SECRET=
COMMS_HUB_PUBLIC_BASE_URL=
COMMS_HUB_D1_PROXY_URL=
COMMS_HUB_D1_PROXY_TOKEN=
