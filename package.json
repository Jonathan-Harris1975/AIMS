{
  "name": "AI-management-suite",
  "version": "2.14.1",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/buildCheck.js",
    "lint": "node scripts/lintCheck.js",
    "repo:hygiene": "python3 scripts/check_repository_hygiene.py",
    "start": "node scripts/bootstrap.js",
    "start:server": "node server.js",
    "check:startup": "node scripts/startupCheck.js",
    "test": "node --test --test-concurrency=1 --test-force-exit --test-timeout=60000 job-store.test.js test/*.test.js docs/comms-hub-auto-migration.test.js",
    "test:smoke": "node --test --test-concurrency=1 --test-force-exit --test-timeout=60000 job-store.test.js test/*.test.js docs/comms-hub-auto-migration.test.js",
    "deploy:install": "npm ci --omit=dev --ignore-scripts --no-audit --no-fund",
    "deploy:smoke": "node scripts/deploySmoke.js",
    "env:doctor": "node scripts/koyebEnvDoctor.js",
    "env:doctor:file": "node scripts/koyebEnvDoctor.js",
    "verify": "npm run lint && npm run repo:hygiene && npm test && npm run build && npm run env:reference:check",
    "env:reference:check": "node scripts/envReference.js --check",
    "env:reference:write": "node scripts/envReference.js --write",
    "blog:repair-links:check": "node scripts/backfill-blog-main-site-links.js",
    "blog:repair-links:apply": "node scripts/backfill-blog-main-site-links.js --apply",
    "comms:migrate": "node scripts/commsHubMigrate.js",
    "comms:migrate:status": "node scripts/commsHubMigrate.js --status",
    "r2:policy:check": "node scripts/r2AccessPolicyCheck.js",
    "secret:scan": "python3 scripts/secret_scan.py",
    "perf:gate": "node scripts/performanceGate.js",
    "koyeb:min-instances:check": "node scripts/verifyKoyebMinInstances.js",
    "test:migrations": "node --test --test-concurrency=1 --test-timeout=60000 test/comms-hub-migration-release-gate.test.js docs/comms-hub-auto-migration.test.js",
    "test:comms:reliability": "node --test --test-concurrency=1 --test-timeout=60000 test/comms-hub-email-reliability.test.js test/comms-hub-runtime-reliability-v2141.test.js test/comms-hub-worker-heartbeat.test.js test/comms-hub-social-all-channels.test.js test/comms-hub-chat-enable-regression.test.js test/comms-hub-phase4-hardening.test.js docs/comms-hub-notification-delivery.test.js",
    "verify:release": "npm run verify && npm run test:migrations && npm run test:comms:reliability && npm run deploy:smoke && npm run perf:gate && npm run secret:scan && npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": "22.22.3",
    "npm": "10.9.8"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1137.0",
    "@aws-sdk/client-s3": "^3.1137.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "googleapis": "^181.0.0",
    "node-fetch": "^3.3.2",
    "p-limit": "^7.3.3",
    "pino": "^10.3.1",
    "pino-http": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.63.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.25.76"
  },
  "private": true,
  "devDependencies": {
    "supertest": "^7.3.0"
  },
  "packageManager": "npm@10.9.8"
}
