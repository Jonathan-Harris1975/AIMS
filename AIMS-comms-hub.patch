+test("schema readiness requires the governed migration ledger entry", async () => {
+  const { database, repository } = await setup();
+  database.exec(`CREATE TABLE comms_hub_schema_migrations (
+    version TEXT PRIMARY KEY,
+    checksum TEXT NOT NULL,
+    applied_at TEXT NOT NULL
+  )`);
+  assert.deepEqual(await repository.schemaStatus(), {
+    available: false,
+    migrations: [],
+    missing: ["0001_comms_hub"],
+  });
+  database.prepare("INSERT INTO comms_hub_schema_migrations (version, checksum, applied_at) VALUES (?, ?, ?)")
+    .run("0001_comms_hub", "test-checksum", "2026-07-30T21:00:00.000Z");
+  const ready = await repository.schemaStatus();
+  assert.equal(ready.available, true);
+  assert.deepEqual(ready.missing, []);
+});
