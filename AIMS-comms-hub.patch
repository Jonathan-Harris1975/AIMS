+import test from "node:test";
+import assert from "node:assert/strict";
+import express from "express";
+import request from "supertest";
+import { createCommsHubRouter } from "../services/comms-hub/routes/index.js";
+
+function withEnv(values, fn) {
+  const previous = {};
+  for (const [key, value] of Object.entries(values)) {
+    previous[key] = process.env[key];
+    if (value === undefined) delete process.env[key]; else process.env[key] = value;
+  }
+  return Promise.resolve().then(fn).finally(() => {
+    for (const [key, value] of Object.entries(previous)) {
+      if (value === undefined) delete process.env[key]; else process.env[key] = value;
+    }
+  });
+}
+
+const enabledEnv = {
+  COMMS_HUB_ENABLED: "true",
+  D1_UUID: "database-id",
+  D1_API_KEY: "d1-key",
+  JOTFORM_API_KEY: "jotform-key",
+  R2_ENDPOINT: "https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com",
+  R2_ACCESS_KEY_ID: "r2-access",
+  R2_SECRET_ACCESS_KEY: "r2-secret",
+  R2_BUCKET_COMMS_HUB: "comms-hub",
+  R2_PUBLIC_BASE_URL_COMMS_HUB: "https://pub.example.invalid",
+};
+
+function testApp(overrides = {}) {
+  const calls = { verified: 0, persisted: 0, kicked: 0 };
+  const context = {
+    jotform: {
+      verifySubmission: async ({ formId, submissionId }) => {
+        calls.verified += 1;
+        return { id: submissionId, form_id: formId, created_at: "2026-07-30 21:20:00", answers: {} };
+      },
+    },
+    repository: {
+      persistJotformIntake: async () => { calls.persisted += 1; return { duplicate: false }; },
+    },
+    ...overrides,
+  };
+  const app = express();
+  app.use(express.json());
+  app.use(express.urlencoded({ extended: true }));
+  app.use("/comms-hub", createCommsHubRouter({
+    contextProvider: () => context,
+    kickArchive: () => { calls.kicked += 1; return true; },
+    runtimeReadinessProvider: () => ({ status: "ready", ready: true, detail: "test" }),
+  }));
+  return { app, calls };
+}
+
+test("Jotform route performs API re-verification before persistence", async () => {
+  await withEnv(enabledEnv, async () => {
+    const { app, calls } = testApp();
+    const result = await request(app).post("/comms-hub/intake/jotform").type("form").send({ formID: "262097861889073", submissionID: "700000000000004" });
+    assert.equal(result.status, 202);
+    assert.equal(result.body.accepted, true);
+    assert.equal(result.body.conversationId, undefined);
+    assert.equal(result.body.eventId, undefined);
+    assert.equal(result.body.workflow, undefined);
+    assert.deepEqual(calls, { verified: 1, persisted: 1, kicked: 1 });
+  });
+});
+
+test("unregistered Jotforms are rejected before external verification or D1 writes", async () => {
+  await withEnv(enabledEnv, async () => {
+    const { app, calls } = testApp();
+    const result = await request(app).post("/comms-hub/intake/jotform").send({ formID: "999999999999999", submissionID: "700000000000004" });
+    assert.equal(result.status, 403);
+    assert.equal(result.body.error, "jotform_form_not_allowed");
+    assert.deepEqual(calls, { verified: 0, persisted: 0, kicked: 0 });
+  });
+});
+
+
+test("Jotform intake fails closed until the Comms Hub runtime and schema are ready", async () => {
+  await withEnv(enabledEnv, async () => {
+    const calls = { verified: 0, persisted: 0 };
+    const context = {
+      jotform: { verifySubmission: async () => { calls.verified += 1; } },
+      repository: { persistJotformIntake: async () => { calls.persisted += 1; } },
+    };
+    const app = express();
+    app.use(express.json());
+    app.use("/comms-hub", createCommsHubRouter({
+      contextProvider: () => context,
+      runtimeReadinessProvider: () => ({ status: "schema_missing", ready: false, detail: "run_npm_comms_migrate" }),
+    }));
+    const result = await request(app).post("/comms-hub/intake/jotform").send({
+      formID: "260281179574362",
+      submissionID: "700000000000004",
+    });
+    assert.equal(result.status, 503);
+    assert.equal(result.body.error, "comms_hub_not_ready");
+    assert.deepEqual(calls, { verified: 0, persisted: 0 });
+  });
+});
