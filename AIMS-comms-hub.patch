+  assert.throws(() => database.prepare("INSERT INTO comms_hub_conversations (id,channel,provider,workflow,status,contact_id,subject,source_reference,created_at,updated_at,last_message_at,metadata_json) VALUES ('x','form','jotform','x','bad','missing','x','x','x','x','x','{}')").run());
+});
