# Canonical AIMS Koyeb production secrets/sensitive overlay.
# Commit-safe: contains secret references only, never secret values.
# Non-secret production values remain in config/production.defaults.env.

# Core / integrations
AIMS_API_KEY={{ secret.AIMS_API_KEY }}
API_HUNTER_KEY={{ secret.API_HUNTER_KEY }}
API_KEY_PODCAST_INDEX={{ secret.API_KEY_PODCAST_INDEX }}
API_OPENPAGERANK_KEY={{ secret.API_OPENPAGERANK_KEY }}
API_SECRET_PODCAST_INDEX={{ secret.API_SECRET_PODCAST_INDEX }}
API_SERP_KEY={{ secret.API_SERP_KEY }}
API_URLSCAN_KEY={{ secret.API_URLSCAN_KEY }}
API_ZERO_KEY={{ secret.API_ZERO_KEY }}
AUDIT_CALLBACK_TOKEN={{ secret.AUDIT_CALLBACK_TOKEN }}
AWS_ACCESS_KEY_ID={{ secret.AWS_ACCESS_KEY_ID }}
AWS_SECRET_ACCESS_KEY={{ secret.AWS_SECRET_ACCESS_KEY }}
BLOTATO_API_KEY={{ secret.BLOTATO_API_KEY }}
CF_ACCOUNT_ID={{ secret.CF_ACCOUNT_ID }}
CF_PURGE={{ secret.CF_PURGE }}
CF_ZONE={{ secret.CF_ZONE }}
CLOUDFLARE_ACCOUNT_ID={{ secret.CLOUDFLARE_ACCOUNT_ID }}
GITHUB_TOKEN_WEBSITE_AUDITS={{ secret.GITHUB_TOKEN_WEBSITE_AUDITS }}
GOOGLE_PRIVATE_KEY={{ secret.GOOGLE_PRIVATE_KEY }}
OPENROUTER_API_KEY={{ secret.OPENROUTER_API_KEY }}
R2_ACCESS_KEY_ID={{ secret.R2_ACCESS_KEY_ID }}
R2_SECRET_ACCESS_KEY={{ secret.R2_SECRET_ACCESS_KEY }}
RAPIDAPI_KEY={{ secret.RAPIDAPI_KEY }}
RMS_API_KEY={{ secret.RMS_API_KEY }}
SITE_SHELL_SYNC_SHARED_SECRET={{ secret.SITE_SHELL_SYNC_SHARED_SECRET }}
WEBSITE_REBUILD_HOOK={{ secret.WEBSITE_REBUILD_HOOK }}

# Newsletter. Required while AIMS_OPERATION_NEWSLETTER_ENABLED=true.
BREVO_API_KEY={{ secret.BREVO_API_KEY }}

# Comms Hub secrets / sensitive identifiers
CLOUDFLARE_AI_SEARCH_API_TOKEN={{ secret.CLOUDFLARE_AI_SEARCH_API_TOKEN }}
COMMS_HUB_ATTACHMENT_SCANNER_TOKEN={{ secret.COMMS_HUB_ATTACHMENT_SCANNER_TOKEN }}
COMMS_HUB_COGINPAL_WEBHOOK_SECRET={{ secret.COMMS_HUB_COGINPAL_WEBHOOK_SECRET }}
COMMS_HUB_D1_PROXY_TOKEN={{ secret.COMMS_HUB_D1_PROXY_TOKEN }}
COMMS_HUB_RBAC_DELEGATION_SECRET={{ secret.COMMS_HUB_RBAC_DELEGATION_SECRET }}
D1_API_KEY={{ secret.CF-database-hive-API }}
D1_UUID={{ secret.D1_UUID_AIMS }}
JOTFORM_API_KEY={{ secret.JOTFORM_API_KEY }}
# Only info@ is consumed by AIMS Comms Hub. Admin/newsletter mailbox secrets stay outside this service.
ONECOM_INFO_PASSWORD={{ secret.info-Jonathan-harris }}
ZERNIO_META_API_KEY={{ secret.ZERNIO_META_API_KEY }}
ZERNIO_META_WEBHOOK_SECRET={{ secret.ZERNIO_META_WEBHOOK_SECRET }}
ZERNIO_VIDEO_API_KEY={{ secret.ZERNIO_VIDEO_API_KEY }}
ZERNIO_VIDEO_WEBHOOK_SECRET={{ secret.ZERNIO_VIDEO_WEBHOOK_SECRET }}

# Optional operational alerting. Add both or neither.
# OPS_ALERT_WEBHOOK_URL={{ secret.OPS_ALERT_WEBHOOK_URL }}
# OPS_ALERT_WEBHOOK_TOKEN={{ secret.OPS_ALERT_WEBHOOK_TOKEN }}
# QA_ALERT_WEBHOOK_URL={{ secret.QA_ALERT_WEBHOOK_URL }}

# Intentionally omitted:
# WEB_API_KEY - no runtime references in AIMS v2.14.1. Remove from Koyeb unless another external service still consumes it.
# R2_PUBLIC_BASE_URL_AUDITS - audits are private and this must remain blank.

# Non-secret Comms Hub values intentionally live in config/production.defaults.env:
# COMMS_HUB_AI_SEARCH_INSTANCES=jonathan_harris_online
# COMMS_HUB_D1_PROXY_URL=https://aims-comms-hub-data-plane.solitary-salad-3d16.workers.dev/query
# COMMS_HUB_JOTFORM_SOURCE_TIMEZONE=Europe/London
# COMMS_HUB_PUBLIC_BASE_URL=https://zeroth-kara-jonathanharris-3296ed37.koyeb.app
# R2_BUCKET_COMMS_HUB_PRIVATE=comms-hub-private

# Comms Hub governed backup/restore and retention. AIMS discovers or creates the
# named restore D1 database and refuses to use D1_UUID as the restore target.
COMMS_HUB_BACKUP_ENABLED=true
COMMS_HUB_BACKUP_AUTOMATIC_ENABLED=true
COMMS_HUB_BACKUP_INTERVAL_MS=86400000
R2_BUCKET_COMMS_HUB_RESTORE=comms-hub-restore
COMMS_HUB_RESTORE_DATABASE=COMMS_HUB_RESTORE_DATABASE
# Optional UUID override; normally leave unset so AIMS owns creation/discovery.
# COMMS_HUB_RESTORE_DATABASE_ID={{ secret.COMMS_HUB_RESTORE_DATABASE_ID }}
COMMS_HUB_RETENTION_WORKER_ENABLED=true
COMMS_HUB_RETENTION_POLL_MS=86400000
COMMS_HUB_RETENTION_BATCH_SIZE=50
