{
  "schema_version": "aims.hive_skills.central_r2.v4",
  "repo": "AIMS",
  "status": "centralised",
  "r2": {
    "bucket_env": "R2_BUCKET_HIVE_SKILLS",
    "bucket_default": "hive-skills",
    "manifest_path": "manifests/aims-skills-manifest.json",
    "skills_index_path": "index/skills-index.json",
    "search_documents_path": "index/search-documents.json",
    "audit_skill_documents_index_path": "index/audit-skill-documents.json",
    "access_mode": "private-r2-read-only"
  },
  "audit_skill_documents": [
    {
      "name": "brand-social-council",
      "skill_id": "S202",
      "object_key": "skills/S202_brand-social-council.json",
      "mime_type": "application/json",
      "source_format": "embedded_markdown"
    }
  ],
  "policy": {
    "local_agents_folder_required": false,
    "local_skill_files_required": false,
    "local_skill_install_scripts_required": false,
    "direct_skill_execution_allowed": false,
    "execution_owner": "HIVE",
    "repo_access_model": "authenticated read-only manifest consumer",
    "llm_direct_access_required": false,
    "default_mode": "discover/read_metadata/dry_run/request_hive_api"
  }
}
