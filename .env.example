# AIMS local/deployment example. Keep real values in Koyeb Secrets, not in git.

# ------------------------------------------------------------------
# App / core
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_TITLE=AI Management Suite
APP_URL=http://localhost:3000
SITE_BASE_URL=https://jonathan-harris.online
SITE_SHELL_MANIFEST_URL=https://jonathan-harris.online/assets/site-shell/manifest.json
SITE_SHELL_ALLOWED_HOSTS=jonathan-harris.online
SITE_SHELL_SYNC_SHARED_SECRET=
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
STATE_BACKEND=auto
ALLOW_EPHEMERAL_STATE=true
APP_STATE_DIR=/tmp/ai-management-suite/state
STATE_REMOTE_PREFIX=state
AIMS_OPS_PREFLIGHT_STRICT=false

# ------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------
# Production: set AIMS_API_KEY as a Koyeb secret. AI_SUITE_API_KEY is fallback only.
AIMS_API_KEY=
AI_SUITE_API_KEY=
AUDIT_CALLBACK_TOKEN=

# ------------------------------------------------------------------
# OpenRouter / AI
# ------------------------------------------------------------------
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=AI Management Suite
OPENROUTER_SITE_URL=https://app.jonathan-harris.online
OPENROUTER_ENABLE_FALLBACKS=true
OPENROUTER_REQUIRE_PARAMETERS_FOR_JSON=true
AI_MODEL_FAST=google/gemini-2.5-flash-lite
AI_MODEL_STANDARD=openai/gpt-5.6-luna
AI_MODEL_HIGH_QUALITY=anthropic/claude-sonnet-4.6
AI_MODEL_FALLBACK=openai/gpt-5.6-sol
AI_MODEL_JSON=openai/gpt-5.6-luna
AI_MODEL_AUDIT=anthropic/claude-sonnet-4.6
AI_TIMEOUT=90000
AI_MAX_RETRIES=4

# Podcast long-form model output budgets
PODCAST_SYNTHESIS_MAX_TOKENS=24000
PODCAST_SYNTHESIS_TIMEOUT_MS=900000
PODCAST_EDITORIAL_MAX_TOKENS=32000
PODCAST_EDITORIAL_TIMEOUT_MS=900000
PODCAST_REPAIR_MAX_TOKENS=16000
PODCAST_REPAIR_TIMEOUT_MS=900000
PODCAST_SYNTHESIS_REASONING_EFFORT=low
PODCAST_EDITORIAL_REASONING_EFFORT=none
PODCAST_REPAIR_REASONING_EFFORT=none
OPENROUTER_CLAUDE_SONNET_5=anthropic/claude-sonnet-4.6
OPENROUTER_CLAUDE_OPUS_4_7=anthropic/claude-opus-4.7
OPENROUTER_GPT_5_6_SOL=openai/gpt-5.6-sol

# ------------------------------------------------------------------
# Cloudflare R2 durable state and artefacts
# ------------------------------------------------------------------
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_META_SYSTEM=metasystem
R2_BUCKET_AUDITS=audits
R2_PUBLIC_BASE_URL_AUDITS=https://pub-f6b6cfd7d07e46f695d08e4a8dc3bd6b.r2.dev
R2_BUCKET_HIVE_SKILLS=hive-skills
R2_PUBLIC_BASE_URL_HIVE_SKILLS=https://pub-da50a6512f164566955a3076a1c795ef.r2.dev
R2_BUCKET_BRAND_ASSETS=brand-assets
R2_PUBLIC_BASE_URL_BRAND_ASSETS=https://assets.jonathan-harris.online
R2_BUCKET_PODCAST=podcast
R2_BUCKET_RAW=podcast-chunks
R2_BUCKET_RAW_TEXT=raw-text
R2_BUCKET_META=podcast-meta
R2_BUCKET_MERGED=podcast-merged
R2_BUCKET_ART=podcastart
R2_BUCKET_RSS_FEEDS=rss-feeds
R2_BUCKET_PODCAST_RSS_FEEDS=podcast-rss-feeds
R2_BUCKET_BLOG=blog
R2_BUCKET_BLOG_IMAGES=blog-images
R2_BUCKET_BLOG_RSS=rss-feed-blog

# ------------------------------------------------------------------
# Audit callback / GitHub dispatch
# ------------------------------------------------------------------
AUDIT_WEBSITE_REPO_OWNER=Jonathan-Harris1975
AUDIT_WEBSITE_REPO_NAME=jonathan-harris-website
AUDIT_WEBSITE_REPO_REF=main
GITHUB_TOKEN_WEBSITE_AUDITS=
AUDIT_AI_TIMEOUT_MS=240000
AUDIT_ANALYSIS_MAX_WAIT_SECONDS=900

# ------------------------------------------------------------------
# Cloudflare purge
# ------------------------------------------------------------------
CF_zone=
CF_purge=
CLOUDFLARE_PURGE_SHARED_SECRET=
CLOUDFLARE_PURGE_ALLOW_PUBLIC=false
CLOUDFLARE_PURGE_TIMEOUT_MS=15000

# ------------------------------------------------------------------
# Blotato
# ------------------------------------------------------------------
Blotato_API_key=
BLOTATO_API_BASE=https://backend.blotato.com/v2
BLOTATO_TIMEOUT_MS=30000
BLOTATO_NEWS_TEMPLATE_ID=/base/v2/ai-story-video/5903fe43-514d-40ee-a060-0d6628c5f8fd/v1
BLOTATO_NEWS_RSS_URL=https://ai-news.jonathan-harris.online/feed.xml
BLOTATO_DEFAULT_CHANNELS=instagram,youtube,tiktok,facebook

# Future Blotato scheduled-post calendar.
# Times are Europe/London local time (GMT/BST automatically) and are intentionally
# separate from today's publish-now orchestration. They become the source of truth
# when AIMS moves safely to Blotato scheduled publishing.
BLOTATO_SCHEDULE_TIMEZONE=Europe/London
BLOTATO_SCHEDULE_MONDAY_AM=10:30
BLOTATO_SCHEDULE_MONDAY_PM=18:30
BLOTATO_SCHEDULE_TUESDAY_AM=10:30
BLOTATO_SCHEDULE_TUESDAY_PM=18:30
BLOTATO_SCHEDULE_WEDNESDAY_AM=10:30
BLOTATO_SCHEDULE_WEDNESDAY_PM=19:00
BLOTATO_SCHEDULE_THURSDAY_AM=10:30
BLOTATO_SCHEDULE_THURSDAY_PM=19:00
BLOTATO_SCHEDULE_FRIDAY_AM=10:30
BLOTATO_SCHEDULE_FRIDAY_PM=16:30
BLOTATO_REQUIRE_ALL_CHANNELS=false
BLOTATO_PUBLISH_WEBHOOK_SECRET=
BLOTATO_ALLOW_PUBLIC_PUBLISH_HOOKS=false
BLOTATO_DEFAULT_FOLLOW_CTA=For straight-talking artificial intelligence analysis, keep Jonathan Harris on your radar.
BLOTATO_HOOK_VARIANTS=2
BLOTATO_VIDEO_SCENE_COUNT=7
BLOTATO_QUALITY_RETRY_ATTEMPTS=3
BLOTATO_HUMAN_VISUALS_ENABLED=true
BLOTATO_HUMAN_VISUAL_MIN_SCENES=3
BLOTATO_THUMBNAIL_TEXT_WORDS=4

# ------------------------------------------------------------------
# Zernio (social scheduling, analytics and reporting)
# Single unified integration: posting/scheduling (services/zernio) and the
# monthly analysis-only report (audits/utils/zernioSocialPerformance.js)
# share the same client credentials below.
# ------------------------------------------------------------------
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
ZERNIO_META_API_KEY=
ZERNIO_VIDEO_API_KEY=
ZERNIO_DEFAULT_DRY_RUN=true
ZERNIO_TIMEZONE=Europe/London
ZERNIO_VALIDATE_TARGET_ACCOUNTS=true
ZERNIO_META_PLATFORMS=facebook,instagram
ZERNIO_VIDEO_PLATFORMS=youtube,tiktok
ZERNIO_ANALYTICS_SOURCE=all
ZERNIO_REPORT_NAME=Jonathan Harris Monthly Social Performance Report
# All Zernio posts use the single "Default" profile in the connected account.
ZERNIO_PROFILE_NAME_GENERAL=Default
ZERNIO_PROFILE_NAME_EBOOKS=Default
# Daily repost of the blog service's public social RSS feed (Zernio has no
# native RSS import, so this is fetched and posted from the AIMS side).
ZERNIO_BLOG_RSS_FEED_URL=https://blog-rss.jonathan-harris.online/social-media-blog/feed.xml
ZERNIO_BLOG_RSS_TIME=09:15

# ------------------------------------------------------------------
# Podcast / TTS
# ------------------------------------------------------------------
PODCAST_TITLE=Turing's Torch Weekly | Artificial Intelligence News
PODCAST_AUTHOR=Jonathan Harris | Artificial Intelligence News Host
PODCAST_DESCRIPTION=Jonathan Harris covers artificial intelligence news, AI breakthroughs and technology trends with sharp analysis and British Gen X realism.
PODCAST_LINK=https://jonathan-harris.online/podcast/
PODCAST_OWNER_NAME=Jonathan Harris
PODCAST_OWNER_EMAIL=
PODCAST_RSS_FEED_URL=https://podcast-rss-feeds.jonathan-harris.online/turing-torch.xml
PODCAST_INTRO_URL=
PODCAST_OUTRO_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
POLLY_VOICE_ID=Brian

# ------------------------------------------------------------------
# Outreach / enrichment
# ------------------------------------------------------------------
APOLLO_API_KEY=
HUNTER_API_KEY=
SERP_API_KEY=
URLSCAN_API_KEY=
ZEROBOUNCE_API_KEY=
OUTREACH_BATCH_SIZE=20
OUTREACH_PROGRESS_KEY=outreach/progress.json

# ------------------------------------------------------------------
# HIVE operations alerting
# ------------------------------------------------------------------
AIMS_FAILURE_ALERT_THRESHOLD=3
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_TOKEN=
OPS_ALERT_TIMEOUT_MS=8000
