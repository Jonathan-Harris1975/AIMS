+import test from "node:test";
+import assert from "node:assert/strict";
+import { CommsHubArchiveWorker } from "../services/comms-hub/workers/archiveWorker.js";
+
+const config = {
+  r2BucketAlias: "commsHub",
+  archiveBatchSize: 10,
+  archiveLeaseMs: 120000,
+  archiveMaxAttempts: 3,
+  archiveWorkerEnabled: true,
+  archivePollMs: 60000,
+};
+
+function jobFixture(overrides = {}) {
+  return {
+    event_id: "evt_01k1f5qfh0t3qp98y50v6x42p2",
+    conversation_id: "cnv_01k1f5qfh0t3qp98y50v6x42p2",
+    provider: "jotform",
+    form_id: "260281179574362",
+    submission_id: "700000000000099",
+    received_at: "2026-07-30T21:00:00.000Z",
+    processed_at: "2026-07-30T21:01:00.000Z",
+    payload_sha256: "a".repeat(64),
+    archive_key: "receipts/2026/07/30/evt_test.json",
+    archive_attempts: 1,
+    ...overrides,
+  };
+}
+
+test("archive worker uploads only a redacted integrity receipt and completes the leased job", async () => {
+  const job = jobFixture();
+  const calls = [];
+  let claimed = false;
+  const repository = {
+    claimArchiveJob: async () => {
+      if (claimed) return null;
+      claimed = true;
+      return job;
+    },
+    completeArchiveJob: async (value) => calls.push(["complete", value]),
+    failArchiveJob: async (value) => calls.push(["fail", value]),
+  };
+  const worker = new CommsHubArchiveWorker({
+    repository,
+    config,
+    workerId: "worker-test",
+    logger: { info() {}, warn() {}, error() {} },
+    uploadText: async (...args) => calls.push(["upload", args]),
+  });
+
+  const result = await worker.runOnce({ limit: 2 });
+  assert.deepEqual(result, { skipped: false, processed: 1, completed: 1, failed: 0 });
+  const receipt = calls.find(([name]) => name === "upload")[1][2];
+  assert.doesNotMatch(receipt, /260281179574362|700000000000099/);
+  assert.match(receipt, /sourceReferenceSha256/);
+  assert.equal(calls.some(([name]) => name === "complete"), true);
+  assert.equal(calls.some(([name]) => name === "fail"), false);
+});
+
+test("archive worker classifies temporary upload failure and releases the lease for retry", async () => {
+  const job = jobFixture();
+  let claimed = false;
+  let failure = null;
+  const repository = {
+    claimArchiveJob: async () => {
+      if (claimed) return null;
+      claimed = true;
+      return job;
+    },
+    completeArchiveJob: async () => assert.fail("completion must not run"),
+    failArchiveJob: async (value) => { failure = value; return true; },
+  };
+  const worker = new CommsHubArchiveWorker({
+    repository,
+    config,
+    workerId: "worker-test",
+    logger: { info() {}, warn() {}, error() {} },
+    uploadText: async () => {
+      const error = new Error("temporary failure for ada@example.com");
+      error.statusCode = 503;
+      throw error;
+    },
+  });
+
+  const result = await worker.runOnce({ limit: 1 });
+  assert.deepEqual(result, { skipped: false, processed: 1, completed: 0, failed: 1 });
+  assert.equal(failure.status, "failed");
+  assert.equal(failure.failureClass, "temporary");
+  assert.doesNotMatch(failure.errorMessage, /ada@example\.com/);
+  assert.match(failure.errorMessage, /redacted-email/);
+});
