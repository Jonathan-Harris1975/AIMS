+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { DatabaseSync } from "node:sqlite";
+import { COMMS_HUB_FORM_ROUTES } from "../services/comms-hub/config.js";
+import { buildJotformIntake } from "../services/comms-hub/domain/submission.js";
+import { CommsHubRepository } from "../services/comms-hub/repositories/commsRepository.js";
+
+class SqliteD1 {
+  constructor(database) { this.database = database; }
+  query(sql, params = []) {
+    const statement = this.database.prepare(sql);
+    const isReturning = /\bRETURNING\b/i.test(sql);
+    const isSelect = /^\s*SELECT\b/i.test(sql);
+    if (isReturning || isSelect) return Promise.resolve({ success: true, results: statement.all(...params), meta: {} });
+    const result = statement.run(...params);
+    return Promise.resolve({ success: true, results: [], meta: { changes: result.changes } });
+  }
+  async batch(statements) {
+    this.database.exec("BEGIN");
+    try {
+      const results = [];
+      for (const statement of statements) results.push(await this.query(statement.sql, statement.params || []));
+      this.database.exec("COMMIT");
+      return results;
+    } catch (error) {
+      this.database.exec("ROLLBACK");
+      throw error;
+    }
+  }
+}
+
+async function setup() {
+  const database = new DatabaseSync(":memory:");
+  database.exec(await readFile(new URL("../services/comms-hub/migrations/0001_comms_hub.sql", import.meta.url), "utf8"));
+  return { database, repository: new CommsHubRepository(new SqliteD1(database)) };
+}
+
+function intakeFixture() {
+  return buildJotformIntake({
+    formId: "262063136008044",
+    submissionId: "700000000000002",
+    route: COMMS_HUB_FORM_ROUTES["262063136008044"],
+    correlationId: "repository-test",
+    now: new Date("2026-07-30T21:10:00.000Z"),
+    submission: {
+      id: "700000000000002",
+      form_id: "262063136008044",
+      created_at: "2026-07-30 21:09:00",
+      answers: {
+        1: { type: "control_fullname", answer: { first: "Grace", last: "Hopper" } },
+        2: { type: "control_email", answer: "grace@example.com" },
+        3: { type: "control_textarea", text: "Case study", answer: "Compiler evidence" },
+        4: { type: "control_fileupload", text: "Document", answer: "https://www.jotform.com/uploads/example/case-study.pdf" },
+      },
+    },
+  });
+}
+
+test("D1 migration creates governed Comms Hub tables and constraints", async () => {
+  const { database } = await setup();
+  const names = database.prepare("SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name").all().map((row) => row.name);
+  for (const expected of [
+    "comms_hub_contacts",
+    "comms_hub_conversations",
