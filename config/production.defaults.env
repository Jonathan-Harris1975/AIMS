# -----------------------------------------------------------------------------
# RSS FEED PIPELINE
# -----------------------------------------------------------------------------
FEED_URL=https://ai-news.jonathan-harris.online/feed.xml
RSS_OBJECT_KEY=feed.xml
RSS_FEED_TITLE=Your AI daily news Briefing
RSS_FEED_DESCRIPTION=A crisp, daily rundown of the biggest moves in artificial intelligence — curated with a Gen-X dose of realism. No fluff, no breathless hype. Just the insights, breakthroughs, and trends that matter, delivered straight to your inbox.
RSS_LINKS_PATH_PREFIX=/rss-links
RSS_LINKS_UNIQUE=true
RSS_MIN_SOURCE_CHARS=220
