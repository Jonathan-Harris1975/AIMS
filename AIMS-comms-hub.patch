+import test from "node:test";
+import assert from "node:assert/strict";
+import { COMMS_HUB_FORM_ROUTES } from "../services/comms-hub/config.js";
+import { buildJotformIntake } from "../services/comms-hub/domain/submission.js";
+import { parseMultipartFields, readJotformWebhookEnvelope, resolveJotformWebhook } from "../services/comms-hub/domain/webhook.js";
+
+const contactRoute = COMMS_HUB_FORM_ROUTES["260281179574362"];
+
+function submissionFixture() {
+  return {
+    id: "700000000000001",
+    form_id: "260281179574362",
+    created_at: "2026-07-30 21:00:00",
+    status: "ACTIVE",
+    answers: {
+      3: { type: "control_fullname", name: "identity", text: "Who are you?", answer: { first: "Ada", last: "Lovelace" } },
+      4: { type: "control_email", name: "returnAddress", text: "Where should we reply?", answer: "ada@example.com" },
+      5: { type: "control_phone", name: "number", text: "Telephone", answer: "+44 20 7000 0000" },
+      6: { type: "control_textarea", name: "question", text: "Your message", answer: "Please contact me about AIMS." },
+      7: { type: "control_fileupload", name: "evidence", text: "Evidence", answer: ["https://www.jotform.com/uploads/example/evidence.pdf"] },
+    },
+  };
+}
+
+test("Comms Hub accepts only the three registered Jotforms", () => {
+  for (const formId of ["260281179574362", "262063136008044", "262097861889073"]) {
+    const result = resolveJotformWebhook({ formID: formId, submissionID: "700000000000001" });
+    assert.equal(result.formId, formId);
+    assert.equal(result.route, COMMS_HUB_FORM_ROUTES[formId]);
+  }
+  assert.throws(
+    () => resolveJotformWebhook({ formID: "999999999999999", submissionID: "700000000000001" }),
+    (error) => error.code === "jotform_form_not_allowed" && error.statusCode === 403
+  );
+});
+
+test("Comms Hub parses Jotform multipart webhook identifiers without accepting uploaded file parts", () => {
+  const boundary = "----jotform-boundary";
+  const body = [
+    `--${boundary}\r\nContent-Disposition: form-data; name="formID"\r\n\r\n260281179574362\r\n`,
+    `--${boundary}\r\nContent-Disposition: form-data; name="submissionID"\r\n\r\n700000000000001\r\n`,
+    `--${boundary}\r\nContent-Disposition: form-data; name="ignored"; filename="payload.bin"\r\nContent-Type: application/octet-stream\r\n\r\nsecret\r\n`,
+    `--${boundary}--\r\n`,
+  ].join("");
+  const parsed = parseMultipartFields(Buffer.from(body), `multipart/form-data; boundary=${boundary}`);
+  assert.deepEqual(parsed, { formID: "260281179574362", submissionID: "700000000000001" });
+});
+
+test("verified Jotform intake uses control types, preserves attachment references in D1 payload, and keeps public receipt redacted", () => {
+  const intake = buildJotformIntake({
+    formId: "260281179574362",
+    submissionId: "700000000000001",
+    route: contactRoute,
+    submission: submissionFixture(),
+    correlationId: "correlation-test",
+    now: new Date("2026-07-30T21:01:00.000Z"),
+  });
+
+  assert.equal(intake.contact.name, "Ada Lovelace");
+  assert.equal(intake.contact.email, "ada@example.com");
+  assert.equal(intake.attachments.length, 1);
+  assert.match(intake.payloadJson, /ada@example\.com/);
+  assert.match(intake.payloadJson, /evidence\.pdf/);
+  assert.doesNotMatch(intake.receiptJson, /Ada|ada@example\.com|Please contact|evidence\.pdf|700000000000001/);
+  assert.match(intake.receiptJson, /sourceReferenceSha256/);
+});
+
+test("conversation, message and event identifiers are deterministic across webhook retries", () => {
+  const input = {
+    formId: "260281179574362",
+    submissionId: "700000000000001",
+    route: contactRoute,
+    submission: submissionFixture(),
+    correlationId: "first",
+    now: new Date("2026-07-30T21:01:00.000Z"),
+  };
+  const first = buildJotformIntake(input);
+  const second = buildJotformIntake({ ...input, correlationId: "second", now: new Date("2026-07-30T22:01:00.000Z") });
+  assert.equal(first.conversationId, second.conversationId);
+  assert.equal(first.messageId, second.messageId);
+  assert.equal(first.eventId, second.eventId);
+});
+
+
+test("parsed JSON and URL-encoded webhook bodies obey the Comms Hub byte limit even without Content-Length", async () => {
+  const req = {
+    body: { formID: "260281179574362", submissionID: "700000000000001" },
+    headers: { "content-type": "application/json" },
+    get(name) { return this.headers[String(name).toLowerCase()]; },
+    aimsParsedBodyBytes: 2049,
+  };
+  await assert.rejects(
+    () => readJotformWebhookEnvelope(req, 2048),
+    (error) => error.code === "jotform_webhook_too_large" && error.statusCode === 413
+  );
+});
