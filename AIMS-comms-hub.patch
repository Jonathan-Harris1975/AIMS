+import test from "node:test";
+import assert from "node:assert/strict";
+import { D1Client } from "../services/comms-hub/clients/d1Client.js";
+import { JotformClient } from "../services/comms-hub/clients/jotformClient.js";
+
+function response(status, body) {
+  return { ok: status >= 200 && status < 300, status, json: async () => body };
+}
+
+const config = {
+  d1DatabaseId: "database-id",
+  d1ApiToken: "d1-token",
+  cloudflareAccountId: "account-id",
+  cloudflareApiBaseUrl: "https://api.cloudflare.test/client/v4",
+  d1TimeoutMs: 15000,
+  jotformApiKey: "jotform-key",
+  jotformApiBaseUrl: "https://api.jotform.test",
+  jotformTimeoutMs: 10000,
+  providerRetryAttempts: 1,
+  providerRetryBaseMs: 1,
+  providerRetryMaxMs: 1,
+};
+
+test("D1 client reuses the Cloudflare query API batch contract and bearer token", async () => {
+  let call;
+  const client = new D1Client(config, { fetchImpl: async (url, init) => {
+    call = { url, init };
+    return response(200, { success: true, result: [
+      { success: true, results: [], meta: {} },
+      { success: true, results: [{ event_id: "evt_1" }], meta: {} },
+    ] });
+  } });
+  const statements = [{ sql: "SELECT ?", params: ["a"] }, { sql: "SELECT ?", params: ["b"] }];
+  const result = await client.batch(statements);
+  assert.equal(result.length, 2);
+  assert.match(call.url, /accounts\/account-id\/d1\/database\/database-id\/query$/);
+  assert.equal(call.init.headers.authorization, "Bearer d1-token");
+  assert.deepEqual(JSON.parse(call.init.body), { batch: statements });
+});
+
+test("Jotform client verifies both submission and form identity", async () => {
+  const client = new JotformClient(config, { fetchImpl: async (url, init) => {
+    assert.match(url, /submission\/700000000000003$/);
+    assert.equal(init.headers.APIKEY, "jotform-key");
+    return response(200, { responseCode: 200, content: { id: "700000000000003", form_id: "262097861889073", answers: {} } });
+  } });
+  const submission = await client.verifySubmission({ formId: "262097861889073", submissionId: "700000000000003" });
+  assert.equal(submission.id, "700000000000003");
+  await assert.rejects(
+    () => client.verifySubmission({ formId: "260281179574362", submissionId: "700000000000003" }),
+    (error) => error.code === "jotform_form_mismatch" && error.statusCode === 403
+  );
+});
