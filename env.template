# env.template for AI-management-suite
# Fill in the values required by the services you actually run.

# ------------------------------------------------------------------
# Core app
# ------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
NODE_OPTIONS=--max-old-space-size=1536
APP_TITLE=AI Management Suite
APP_URL=https://zeroth-kara-jonathanharris-3296ed37.koyeb.app
CORS_ORIGINS=
DEBUG_ROUTES=false

# Suite authentication. Set AIMS_API_KEY as a Koyeb secret in production.
# AI_SUITE_API_KEY is accepted only as a backwards-compatible fallback.
AIMS_API_KEY=
AIMS_ALLOW_UNAUTHENTICATED_DEV=false
AI_SUITE_API_KEY=
SHUTDOWN_TIMEOUT_MS=10000
BOOTSTRAP_STEP_TIMEOUT_MS=120000
# RSS source bootstrap is off by default so deploy health is not delayed by R2/network initialisation.
# Set RSS_INIT_ON_BOOT=true only when you deliberately want RSS init to run after startup.
# Set RSS_INIT_REQUIRED_ON_BOOT=true only when you deliberately want RSS init
# to fail the container if it cannot complete.
RSS_INIT_ON_BOOT=false
RSS_INIT_REQUIRED_ON_BOOT=false
RSS_INIT_POST_START_TIMEOUT_MS=120000
# Startup Check runs after the HTTP server opens /health. It is non-fatal by default
# so deployment health is not blocked by optional runtime binaries in native builders.
# Set STARTUP_CHECK_REQUIRED_POST_START=true to make this check terminate the container on failure.
STARTUP_CHECK_REQUIRED_POST_START=false
AUTO_CALL=yes
INTERNAL_BASE_HOST=127.0.0.1
INTERNAL_BASE_PROTO=http
TRUST_PROXY=1
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb
APP_TMP_DIR=/tmp/ai-management-suite
APP_STATE_DIR=/tmp/ai-management-suite/state
JOB_STATUS_TTL_MS=86400000
REQUEST_DEDUPE_TTL_MS=21600000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
STATE_BACKEND=auto
STATE_REMOTE_PREFIX=state
INTERNAL_ROUTE_TIMEOUT_MS=60000
WEBHOOK_TIMEOUT_MS=15000
FEED_FETCH_TIMEOUT_MS=15000
PODCAST_FETCH_TIMEOUT_MS=30000
ARTWORK_TIMEOUT_MS=600000
ARTWORK_TASK_TIMEOUT_MS=600000
ARTWORK_REQUEST_TIMEOUT_MS=120000
CLOUDFLARE_PURGE_TIMEOUT_MS=15000
# Cloudflare Pages deploy hook URL. Treat as a secret; never commit a live hook.
WEBSITE_REBUILD_HOOK=
WEBSITE_REBUILD_HOOK_FALLBACK=
RSS_OBJECT_KEY=feed.xml
ALLOW_EPHEMERAL_STATE=false

