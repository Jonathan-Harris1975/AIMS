# AIMS local/deployment example. Keep real values in Koyeb Secrets, not in git.

# ------------------------------------------------------------------
# App / core
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_TITLE=AI Management Suite
APP_URL=http://localhost:3000
SITE_BASE_URL=https://jonathan-harris.online
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
STATE_BACKEND=auto
ALLOW_EPHEMERAL_STATE=true
APP_STATE_DIR=/tmp/ai-management-suite/state
STATE_REMOTE_PREFIX=state
AIMS_OPS_PREFLIGHT_STRICT=false

# ------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------
# Production: set AIMS_API_KEY as a Koyeb secret. AI_SUITE_API_KEY is fallback only.
AIMS_API_KEY=
AIMS_ALLOW_UNAUTHENTICATED_DEV=false
AI_SUITE_API_KEY=
AUDIT_CALLBACK_TOKEN=
# Legacy callback-token alias; prefer AUDIT_CALLBACK_TOKEN.
AI_SUITE_AUDIT_CALLBACK_TOKEN=
SITE_SHELL_SYNC_SHARED_SECRET=

# ------------------------------------------------------------------
# OpenRouter / AI
# ------------------------------------------------------------------
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Optional legacy/provider-specific key aliases. Prefer the shared OPENROUTER_API_KEY.
OPENROUTER_API_KEY_ART=
OPENROUTER_API_KEY_ART_BACKUP=
OPENROUTER_API_KEY_GPT_5_6_LUNA=
OPENROUTER_APP_NAME=AI Management Suite
OPENROUTER_SITE_URL=https://app.jonathan-harris.online
OPENROUTER_ENABLE_FALLBACKS=true
OPENROUTER_REQUIRE_PARAMETERS_FOR_JSON=true
AI_MODEL_FAST=google/gemini-2.5-flash-lite
AI_MODEL_STANDARD=openai/gpt-5.6-luna
AI_MODEL_HIGH_QUALITY=anthropic/claude-sonnet-4.6
AI_MODEL_FALLBACK=openai/gpt-5.6-sol
AI_MODEL_JSON=openai/gpt-5.6-luna
AI_MODEL_AUDIT=anthropic/claude-sonnet-4.6
AI_TIMEOUT=90000
AI_MAX_RETRIES=2
HEADROOM_ENABLED=false
HEADROOM_BASE_URL=
HEADROOM_API_KEY=
HEADROOM_PROXY_TOKEN=
HEADROOM_TIMEOUT_MS=5000
HEADROOM_MIN_INPUT_CHARS=2000
HEADROOM_TARGET_RATIO=0.7
HEADROOM_PROTECT_RECENT=0
HEADROOM_COMPRESS_USER_MESSAGES=true
HEADROOM_LOG_SAVINGS=true
HEADROOM_ROUTES=compose,scriptMain,scriptMainSynthesis,editorialPass,editAndFormat,rssRewrite,blogWeekly,blogSocial,onBrandAudit,auditForensic,zernioDaily,zernioMiniSeriesResearch,zernioMiniSeriesTheme,zernioMiniSeriesPost,zernioEbook,blotatoNewsShort,newsletterCompose,newsletterFactCheck,newsletterVoiceReview,newsletterAudienceReview,newsletterCouncilChair
REVIEW_COUNCIL_STAGNATION_LIMIT=2
AI_MODEL_IMAGE=bytedance-seed/seedream-4.5
OPENROUTER_ART=bytedance-seed/seedream-4.5
OPENROUTER_ART_BACKUP=black-forest-labs/flux.2-pro

# Artwork generation. Generic fallback images stay blank so failed provider
# calls cannot publish yesterday's or a stock replacement image.
ARTWORK_TIMEOUT_MS=600000
ARTWORK_TASK_TIMEOUT_MS=600000
ARTWORK_REQUEST_TIMEOUT_MS=120000
ARTWORK_PROVIDER_ATTEMPTS=1
BLOG_ARTWORK_TIMEOUT_MS=600000
NEWSLETTER_ARTWORK_TIMEOUT_MS=600000
SOCIAL_BLOG_ARTWORK_TIMEOUT_MS=600000
ZERNIO_ARTWORK_TIMEOUT_MS=600000
BLOG_FALLBACK_IMAGE_URL=
BLOG_SOCIAL_FALLBACK_IMAGE_URL=
NEWSLETTER_AI_EDGE_FALLBACK_IMAGE_URL=
ARTWORK_VISUAL_QA_ENABLED=true
ARTWORK_VISUAL_QA_REQUIRED=true
ARTWORK_VISUAL_QA_MODES=podcast,blog,newsletter,social,social-blog,quiz
ARTWORK_VISUAL_QA_THRESHOLD=80
SOCIAL_ARTWORK_VISUAL_QA_THRESHOLD=72
SOCIAL_ARTWORK_VISUAL_QA_MIN_RELEVANCE=60
SOCIAL_ARTWORK_VISUAL_QA_MIN_TEXT_SAFETY=90
SOCIAL_ARTWORK_SHORT_PROMPT_RETRY=false
PODCAST_ARTWORK_SHORT_PROMPT_RETRY=false
ARTWORK_VISUAL_QA_MAX_REGENERATIONS=0

# Podcast long-form model output budgets
PODCAST_SYNTHESIS_MAX_TOKENS=24000
PODCAST_SYNTHESIS_TIMEOUT_MS=900000
PODCAST_EDITORIAL_MAX_TOKENS=32000
PODCAST_EDITORIAL_TIMEOUT_MS=900000
PODCAST_REPAIR_MAX_TOKENS=16000
PODCAST_REPAIR_TIMEOUT_MS=900000
PODCAST_SYNTHESIS_REASONING_EFFORT=low
PODCAST_EDITORIAL_REASONING_EFFORT=none
PODCAST_REPAIR_REASONING_EFFORT=none
OPENROUTER_CLAUDE_SONNET_5=anthropic/claude-sonnet-4.6
OPENROUTER_CLAUDE_OPUS_4_7=anthropic/claude-opus-4.7
OPENROUTER_GPT_5_6_SOL=openai/gpt-5.6-sol

