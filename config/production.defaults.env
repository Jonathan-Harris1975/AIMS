REVIEW_COUNCIL_BLOG_PHASE45_ENABLED=true
REVIEW_COUNCIL_ZERNIO_SOCIAL_ENABLED=true
REVIEW_COUNCIL_QUIZ_LOGIC_ENABLED=true
REVIEW_COUNCIL_BLOTATO_SCRIPT_ENABLED=true
REVIEW_COUNCIL_PODCAST_ON_BRAND_ENABLED=true
REVIEW_COUNCIL_SOCIAL_PERFORMANCE_ENABLED=true
REVIEW_COUNCIL_HOUSEKEEPING_ENABLED=true
HOOKDECK_ASYNC_SERVICE_ROUTES=true
ASYNC_SERVICE_ROUTES_ALWAYS=false
R2_UPLOAD_RETRIES=3
R2_RETRY_BASE_MS=400
R2_RETRY_MAX_MS=5000
ZERNIO_THUMBNAIL_AUDIT_NAV_RETRIES=1

# -----------------------------------------------------------------------------
# HOOKDECK
# -----------------------------------------------------------------------------
HOOKDECK_DEDUPE_TTL_MS=21600000


# -----------------------------------------------------------------------------
# CLOUDFLARE
# -----------------------------------------------------------------------------
CLOUDFLARE_PURGE_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------
# WEATHER API
# -----------------------------------------------------------------------------
RAPIDAPI_HOST=weatherapi-com.p.rapidapi.com


# -----------------------------------------------------------------------------
# STATE MANAGEMENT
# -----------------------------------------------------------------------------
STATE_BACKEND=auto
ALLOW_EPHEMERAL_STATE=false
JOB_STATUS_TTL_MS=86400000


# -----------------------------------------------------------------------------
# OPS / PREFLIGHT
# -----------------------------------------------------------------------------
# MAST pre-trigger ops endpoints are warning-only by default.
AIMS_OPS_PREFLIGHT_STRICT=false

PODCAST_TRANSCRIPT_MAX_SENTENCE_WORDS=25
PODCAST_TRANSCRIPT_HARD_MAX_SENTENCE_WORDS=40


# -----------------------------------------------------------------------------
# PROFESSIONAL EXCELLENCE AND CENTRAL ALERTS
# -----------------------------------------------------------------------------
AIMS_FAILURE_ALERT_THRESHOLD=3
OPS_ALERT_TIMEOUT_MS=8000
# OPS_ALERT_WEBHOOK_URL and OPS_ALERT_WEBHOOK_TOKEN are Koyeb secret-backed runtime values.

# -----------------------------------------------------------------------------
# NEWSLETTER ENGINE (services/newsletter) — non-secret production defaults.
# BREVO_API_KEY / NEWSLETTER_AI_EDGE_FROM_EMAIL are Koyeb secret-backed
# runtime values and are intentionally not set here.
# -----------------------------------------------------------------------------
BREVO_RETRIES=3
BREVO_RETRY_BASE_MS=500
BREVO_TIMEOUT_MS=15000
NEWSLETTER_RSS_WINDOW_HOURS=24
NEWSLETTER_STORY_COUNT=10
NEWSLETTER_QA_PASS_THRESHOLD=85
NEWSLETTER_MAX_REWRITE_ITERATIONS=3
NEWSLETTER_RSS_FETCH_RETRIES=3
NEWSLETTER_RSS_FETCH_RETRY_BASE_MS=500
NEWSLETTER_RSS_FETCH_TIMEOUT_MS=15000
