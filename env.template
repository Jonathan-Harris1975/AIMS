# ------------------------------------------------------------------
# RSS Links (URL Shortener)
# ------------------------------------------------------------------
# Base URL used when building the short_url in API responses.
# Leave blank to fall back to APP_URL (recommended until you have a custom domain).
# Once a custom domain is set up, set this to the root of that domain,
# e.g. RSS_LINKS_BASE_URL=https://links.yoursite.com
RSS_LINKS_BASE_URL=

# Path prefix appended to RSS_LINKS_BASE_URL when constructing short URLs.
# Defaults to /rss-links when running under the suite.
# Set to empty string ("") once you're using a dedicated custom domain.
RSS_LINKS_PATH_PREFIX=/rss-links

# Set to "false" to allow duplicate short codes for the same long URL.
# Default is "true" (same long URL always returns the same short code).
RSS_LINKS_UNIQUE=true

