# AIMS Comms Hub v2.14.1 - all conversation channels enabled; Outreach automation is externally triggered.
# Secrets/IDs remain in the deployment environment and are intentionally blank here.
COMMS_HUB_ENABLED=true
COMMS_HUB_AUTO_MIGRATE_ON_START=true
COMMS_HUB_RUNTIME_SUPERVISOR_ENABLED=true
COMMS_HUB_RUNTIME_SUPERVISOR_RETRY_MS=30000
COMMS_HUB_RUNTIME_SUPERVISOR_MAX_RETRY_MS=300000
COMMS_HUB_AI_ENABLED=true
COMMS_HUB_APPROVALS_ENFORCED=true
COMMS_HUB_AUTONOMOUS_REPLIES_ENABLED=true
COMMS_HUB_ZERNIO_META_ENABLED=true
COMMS_HUB_ZERNIO_VIDEO_ENABLED=true
COMMS_HUB_ZERNIO_POLL_ENABLED=true
COMMS_HUB_ZERNIO_WEBHOOK_RECONCILE_ENABLED=true
COMMS_HUB_ZERNIO_WEBHOOK_RECONCILE_INTERVAL_MS=900000
COMMS_HUB_SOCIAL_MONITOR_ONLY=false
COMMS_HUB_EMAIL_ENABLED=true
# Scope boundary: only info@ is automated. These flags remain false even if stale credentials exist.
COMMS_HUB_EMAIL_ADMIN_ENABLED=false
COMMS_HUB_EMAIL_NEWSLETTER_ENABLED=false
COMMS_HUB_EMAIL_POLL_WORKER_ENABLED=true
COMMS_HUB_EMAIL_WORKFLOW_EVALUATION_ENABLED=true
COMMS_HUB_EMAIL_HISTORICAL_BACKFILL_ENABLED=false
COMMS_HUB_EMAIL_EXTERNAL_RECIPIENTS_ENABLED=false
COMMS_HUB_CHAT_ENABLED=true
COMMS_HUB_CHAT_FORCE_DISABLED=false
COMMS_HUB_CHAT_AI_WORKFLOW_ENABLED=true
COMMS_HUB_FORM_ORCHESTRATION_ENABLED=true
COMMS_HUB_FORM_SMART_PROCESSING_ENABLED=true
COMMS_HUB_FORM_AUTO_SEND_ENABLED=true
COMMS_HUB_SMART_CONTEXT_ENABLED=true
COMMS_HUB_SMART_LIVE_CONTENT_ENABLED=true
COMMS_HUB_SMART_STRATEGY_ENABLED=true
COMMS_HUB_SMART_RESPONSE_ENABLED=true
COMMS_HUB_SMART_CONDUCT_ENABLED=true
COMMS_HUB_BAD_LANGUAGE_BLOCK_ENABLED=true
COMMS_HUB_FOLLOW_UP_WORKER_ENABLED=true
COMMS_HUB_PROVIDER_HEALTH_ENABLED=true
COMMS_HUB_DELAYED_ACTION_WORKER_ENABLED=true
COMMS_HUB_EMAIL_INITIAL_REPLY_DELAY_ENABLED=true
COMMS_HUB_FORM_REPLY_DELAY_ENABLED=true
COMMS_HUB_REPLY_DELAY_MIN_DAYS=2
COMMS_HUB_REPLY_DELAY_MAX_DAYS=3
COMMS_HUB_BUSINESS_TIMEZONE=Europe/London
COMMS_HUB_BUSINESS_START_HOUR=9
COMMS_HUB_BUSINESS_END_HOUR=17
COMMS_HUB_HUMAN_HANDOFF_BUSINESS_HOURS_ONLY=true
COMMS_HUB_CALLBACK_EMAIL_CAPTURE_ENABLED=true

# Required deployment-specific values:
COMMS_HUB_AI_SEARCH_INSTANCES=jonathan_harris_online
CLOUDFLARE_AI_SEARCH_API_TOKEN=
ZERNIO_META_API_KEY=
ZERNIO_META_WEBHOOK_SECRET=
ZERNIO_VIDEO_API_KEY=
ZERNIO_VIDEO_WEBHOOK_SECRET=
COMMS_HUB_COGINPAL_WEBHOOK_SECRET=

# Outreach guest-article automation (v2.14.1).
# MAST owns the authenticated twice-daily weekday trigger; keep AIMS Outreach enabled.
OUTREACH_AUTOMATION_ENABLED=true
OUTREACH_SEND_ENABLED=true
OUTREACH_BATCH_CYCLE=true
OUTREACH_TRIGGER_MIN_INTERVAL_MINUTES=300
OUTREACH_MAX_SENDS_PER_BATCH=5
OUTREACH_MAX_SENDS_PER_DAY=10
OUTREACH_FOLLOW_UP_ENABLED=true
OUTREACH_FOLLOW_UP_DAYS=5
OUTREACH_MAX_FOLLOW_UPS=1
OUTREACH_ALLOW_CATCH_ALL=false
OUTREACH_ALLOW_NAMED_BUSINESS_CONTACTS=false
OUTREACH_PAID_PLACEMENT_ENABLED=false
OUTREACH_PITCH_MODEL=anthropic/claude-sonnet-5
OUTREACH_REPLY_MODEL=anthropic/claude-sonnet-5
OUTREACH_ARTICLE_MODEL=anthropic/claude-sonnet-5
OUTREACH_ARTICLE_REVIEW_MODEL=anthropic/claude-opus-4.8
OUTREACH_ARTICLE_FALLBACK_MODEL=openai/gpt-5.6-sol
OUTREACH_ARTICLE_AUTO_WRITE_ENABLED=true
OUTREACH_ARTICLE_AUTO_SEND_ENABLED=true
OUTREACH_ARTICLE_MIN_SCORE=9.1
OUTREACH_MAX_ARTICLE_REVISIONS=3
AIMS_OPERATION_OUTREACH_ENABLED=true
