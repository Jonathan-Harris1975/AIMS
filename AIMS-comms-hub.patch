+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+
+async function source(path) {
+  return readFile(new URL(`../${path}`, import.meta.url), "utf8");
+}
+
+test("Comms Hub is additive to the AIMS route registry and owns no replacement server or package", async () => {
+  const routes = await source("routes/index.js");
+  const serviceFiles = await Promise.all([
+    source("services/comms-hub/index.js"),
+    source("services/comms-hub/routes/index.js"),
+  ]);
