+
+  assert.deepEqual(await repository.persistJotformIntake(first), { duplicate: false });
+  assert.deepEqual(await repository.persistJotformIntake(second), { duplicate: false });
+  assert.equal(database.prepare("SELECT COUNT(*) AS count FROM comms_hub_intake_events").get().count, 2);
+  assert.equal(database.prepare("SELECT COUNT(*) AS count FROM comms_hub_conversations").get().count, 2);
+});
+
