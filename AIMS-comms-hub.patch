+  assert.match(routes, /AIMS Comms Hub/);
+  assert.doesNotMatch(serviceFiles.join("\n"), /app\.listen|createServer\(|process\.on\(|new S3Client/);
+});
+
+test("central auth exposes the exact Jotform ingress and keeps operational routes protected", async () => {
+  const auth = await source("services/shared/middleware/suiteAuth.js");
+  assert.match(auth, /method === "POST" && path === "\/comms-hub\/intake\/jotform"/);
+  assert.match(auth, /strategy: "jotform-api-reverification"/);
+  assert.doesNotMatch(auth, /path\.startsWith\("\/comms-hub"\)/);
+});
+
+test("AIMS lifecycle starts, checks and stops the Comms Hub runtime", async () => {
