# Headroom v0.38.0 (aligned with the Python integrations in HIVE and RAMS).
# Koyeb environment for the companion Headroom service.
# Deploy headroom/Dockerfile as a private service named "headroom" in the same
# Koyeb app as AIMS and expose service port 8787 internally.
HEADROOM_PROXY_TOKEN={{ secret.HEADROOM_PROXY_TOKEN }}
HEADROOM_HOST=0.0.0.0
HEADROOM_PORT=8787
HEADROOM_COMPRESS_ALLOW_REMOTE=1
HEADROOM_SAVINGS_PROFILE=balanced
HEADROOM_MODE=token
HEADROOM_TARGET_RATIO=0.70
HEADROOM_COMPRESS_USER_MESSAGES=true
HEADROOM_COMPRESS_SYSTEM_MESSAGES=false
HEADROOM_PROTECT_RECENT=1
HEADROOM_MIN_TOKENS=250
HEADROOM_KOMPRESS_BACKEND=auto
HEADROOM_TELEMETRY=on
# Local savings remain enabled; anonymous external upload is disabled.
HEADROOM_BEACON=off
DO_NOT_TRACK=1
HEADROOM_WORKSPACE_DIR=/var/lib/headroom
HEADROOM_STATELESS=false
# Mount persistent storage at /var/lib/headroom in the Koyeb service to retain
# Headroom savings history across restarts and deployments.
