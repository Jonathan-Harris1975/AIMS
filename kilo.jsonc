{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "*": "allow",

    "edit": {
      "*": "allow",
      "kilo.jsonc": "deny",
      ".github/workflows/*": "deny",
      ".github/actions/*": "deny",
      ".github/scripts/*": "deny",
      ".github/CODEOWNERS": "deny",
      ".github/dependabot.yml": "deny",
      ".mergify.yml": "deny",
      "renovate.json": "deny",
      ".gitleaks*": "deny",
      "SECURITY.md": "deny",
      "AUTONOMY.md": "deny",
      "CI_SETUP.txt": "deny",
      "scripts/secret_scan.py": "deny",
      "scripts/install_ci_tools.py": "deny",
      "scripts/verify_ci_tool_checksums.py": "deny"
    },
    "write": {
      "*": "allow",
      "kilo.jsonc": "deny",
      ".github/workflows/*": "deny",
      ".github/actions/*": "deny",
      ".github/scripts/*": "deny",
      ".github/CODEOWNERS": "deny",
      ".github/dependabot.yml": "deny",
      ".mergify.yml": "deny",
      "renovate.json": "deny",
      ".gitleaks*": "deny",
      "SECURITY.md": "deny",
      "AUTONOMY.md": "deny",
      "CI_SETUP.txt": "deny",
      "scripts/secret_scan.py": "deny",
      "scripts/install_ci_tools.py": "deny",
      "scripts/verify_ci_tool_checksums.py": "deny"
    },
    "apply_patch": {
      "*": "allow",
      "kilo.jsonc": "deny",
      ".github/workflows/*": "deny",
      ".github/actions/*": "deny",
      ".github/scripts/*": "deny",
      ".github/CODEOWNERS": "deny",
      ".github/dependabot.yml": "deny",
      ".mergify.yml": "deny",
      "renovate.json": "deny",
      ".gitleaks*": "deny",
      "SECURITY.md": "deny",
      "AUTONOMY.md": "deny",
      "CI_SETUP.txt": "deny",
      "scripts/secret_scan.py": "deny",
      "scripts/install_ci_tools.py": "deny",
      "scripts/verify_ci_tool_checksums.py": "deny"
    },

    "external_directory": "deny",
    "question": "deny",

    "bash": {
      "*": "deny",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git branch --show-current *": "allow",
      "git fetch *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git merge origin/main": "allow",
      "git merge --no-edit origin/main": "allow",
      "git merge --abort": "allow",
      "git push origin HEAD": "allow",
      "git push --set-upstream origin HEAD": "allow",
      "git push -u origin HEAD": "allow",

      "npm ci *": "allow",
      "npm test *": "allow",
      "npm run build *": "allow",
      "npm run lint *": "allow",
      "npm run repo:hygiene *": "allow",
      "npm run check:startup *": "allow",
      "npm run env:reference:check *": "allow",
      "npm run verify *": "allow",
      "npm run test:migrations *": "allow",
      "npm run test:comms:reliability *": "allow",
      "npm run secret:scan *": "allow",
      "npm run perf:gate *": "allow",
      "npm run r2:policy:check *": "allow",
      "npm audit *": "allow",

      "python3 .github/scripts/test_autonomy_lifecycle.py *": "allow",
      "python3 .github/scripts/test_pr_blocker_recovery.py *": "allow",
      "python3 scripts/check_repository_hygiene.py *": "allow",
      "python3 scripts/secret_scan.py *": "allow",

      "git checkout main": "deny",
      "git checkout -B main *": "deny",
      "git checkout -b main *": "deny",
      "git switch main": "deny",
      "git switch -C main *": "deny",
      "git switch -c main *": "deny",
      "git push *:*": "deny",
      "git push +*": "deny",
      "git push *--force*": "deny",
      "git push * -f*": "deny",
      "git push *--mirror*": "deny",
      "git push *--delete*": "deny",
      "git push * -d*": "deny",
      "bash -c *": "deny",
      "sh -c *": "deny",
      "zsh -c *": "deny",
      "/bin/bash -c *": "deny",
      "/bin/sh -c *": "deny",
      "env bash *": "deny",
      "env sh *": "deny",
      "/usr/bin/env bash *": "deny",
      "/usr/bin/env sh *": "deny",
      "sudo *": "deny",
      "rm *": "deny",
      "gh pr merge *": "deny",
      "wrangler deploy *": "deny",
      "npx wrangler deploy *": "deny",
      "koyeb *": "deny"
    }
  }
}
