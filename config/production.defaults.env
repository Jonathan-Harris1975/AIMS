RSS_EMPTY_BATCH_ADVANCE_ATTEMPTS=3
RSS_REWRITE_BATCH_ADVANCE_ATTEMPTS=4
RSS_QUARANTINE_FALLBACK_THRESHOLD=1
RSS_REWRITE_MIN_PUBLISHABLE_ITEMS=1

# Phase 3 quality gate
