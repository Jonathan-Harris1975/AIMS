# -----------------------------------------------------------------------------
# BLOTATO — Short Video Pipeline
# -----------------------------------------------------------------------------
# Budget: 20 videos/month × 62 credits = ~1,240 credits/month
# Per video: 7 images (flux-schnell ~1cr each) + 1 framepack render (55cr) = 62cr

BLOTATO_API_BASE=https://backend.blotato.com/v2
BLOTATO_TIMEOUT_MS=30000
BLOTATO_API_RETRY_ATTEMPTS=6
BLOTATO_API_RETRY_BASE_MS=1000
BLOTATO_API_RETRY_MAX_MS=30000

# Template
BLOTATO_NEWS_TEMPLATE_ID=/base/v2/ai-story-video/5903fe43-514d-40ee-a060-0d6628c5f8fd/v1
# Blotato credit guard: cheapest intended budget is 7 x flux schnell images (1 each) + framepack video (55) = 62 credits.
# The API docs now prefer template UUID + prompt/empty inputs. Do not rely on old top-level model fields being honoured.
BLOTATO_TEMPLATE_ID_MODE=uuid
BLOTATO_TEMPLATE_VERIFY=true
BLOTATO_TEMPLATE_AUTO_DISCOVERY=true
BLOTATO_NEWS_TEMPLATE_SEARCH=AI Story Video
BLOTATO_USE_MANUAL_TEMPLATE_INPUTS=false
BLOTATO_VIDEO_SCENE_COUNT=7
BLOTATO_LOW_COST_IMAGE_MODEL_LABEL=flux schnell
BLOTATO_LOW_COST_VIDEO_MODEL_LABEL=framepack
BLOTATO_MAX_EXPECTED_CREDITS=70
BLOTATO_VIDEO_FINAL_GRACE_MS=15000
BLOTATO_VIDEO_POLL_PROGRESS_EVERY=30
BLOTATO_NEWS_JSON_RESPONSE_FORMAT=false
BLOTATO_TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
BLOTATO_TIKTOK_DISABLED_COMMENTS=false
BLOTATO_TIKTOK_DISABLED_DUET=false
BLOTATO_TIKTOK_DISABLED_STITCH=false
BLOTATO_TIKTOK_IS_BRANDED_CONTENT=false
BLOTATO_TIKTOK_IS_YOUR_BRAND=false
BLOTATO_TIKTOK_IS_AI_GENERATED=true

# Media generation cost labels — used for AIMS budget guarding and prompt steering.
# The current Blotato Create Visual API uses template settings + prompt, not old top-level model fields.
# flux-schnell + framepack is the intended lowest-cost combination (~62 credits/video).
BLOTATO_TEXT_TO_IMAGE_MODEL=replicate/flux-schnell
BLOTATO_IMAGE_TO_VIDEO_MODEL=fal-ai/framepack

# Brand kit — passed directly into the Blotato template inputs payload
BLOTATO_BRAND_VOICE_NAME=George (British, authoritative)
BLOTATO_BRAND_HIGHLIGHT_COLOR=#00E5FF
BLOTATO_BRAND_CAPTION_POSITION=bottom
BLOTATO_BRAND_TRANSITION=fade
BLOTATO_BRAND_ASPECT_RATIO=9:16
BLOTATO_BRAND_ANIMATE_IMAGES=true
BLOTATO_BRAND_TRIM_TO_VOICEOVER=true

# Script generation — controls spoken word count and target duration
# 110–165 words at natural pace = 50–75 seconds (raised per audit Gap 1)
# NOTE: BLOTATO_NEWS_SHORT_MAX_TOKENS is an OpenRouter AI token budget,
# NOT a Blotato credit. Has no effect on the 1,240 credit/month budget.
BLOTATO_NEWS_SHORT_MAX_TOKENS=4200
BLOTATO_NEWS_DURATION_SECONDS=45
BLOTATO_NEWS_MIN_SCRIPT_WORDS=110
BLOTATO_NEWS_TARGET_SCRIPT_WORDS=145
BLOTATO_NEWS_MAX_SCRIPT_WORDS=165
BLOTATO_QUALITY_RETRY_ATTEMPTS=3

# Gap 5 — Automated hook expert review.
# Set to 2 to request an alternate hook candidate and auto-select the stronger one.
# Zero manual interaction. Adds no latency (same API call). Default 1 = off.
BLOTATO_HOOK_VARIANTS=2
BLOTATO_HUMAN_VISUALS_ENABLED=true
BLOTATO_HUMAN_VISUAL_MIN_SCENES=3
BLOTATO_THUMBNAIL_TEXT_WORDS=4

# RSS source — shared default feed
BLOTATO_NEWS_RSS_URL=https://ai-news.jonathan-harris.online/feed.xml
BLOTATO_RSS_PREFER_R2=true
BLOTATO_RSS_BUCKET_ALIAS=rss
BLOTATO_RSS_JSON_KEY=feed.json
BLOTATO_RSS_PICK_MODE=latest

# Gap 4 — Per-lane RSS source overrides.
# Each lane triggers once per week on its scheduled weekday.
# RSS feeds pull fresh content daily so each lane always gets a relevant recent article.
# Leave a lane key blank to fall back to the shared BLOTATO_NEWS_RSS_URL above.
# Example: point model-verdict at a dedicated AI tools feed.
BLOTATO_NEWS_INSIGHT_RSS_URL=
BLOTATO_MODEL_VERDICT_RSS_URL=
BLOTATO_AI_AT_WORK_RSS_URL=
BLOTATO_REALITY_CHECK_RSS_URL=
BLOTATO_AI_PLAYBOOK_RSS_URL=

# Publishing channels
BLOTATO_DEFAULT_CHANNELS=instagram,youtube,tiktok,facebook
BLOTATO_INSTAGRAM_ACCOUNT_ID=48812
BLOTATO_YOUTUBE_ACCOUNT_ID=37622
BLOTATO_TIKTOK_ACCOUNT_ID=44263
BLOTATO_FACEBOOK_ACCOUNT_ID=34013
BLOTATO_FACEBOOK_PAGE_ID=562160556971997
BLOTATO_YOUTUBE_PRIVACY_STATUS=public
BLOTATO_YOUTUBE_NOTIFY_SUBSCRIBERS=false
BLOTATO_INSTAGRAM_SHARE_TO_FEED=true

# Polling — video render and post publish
BLOTATO_VIDEO_POLL_ATTEMPTS=720
BLOTATO_VIDEO_POLL_INTERVAL_MS=5000
BLOTATO_POST_POLL_ATTEMPTS=120
BLOTATO_POST_POLL_INTERVAL_MS=3000
BLOTATO_REQUIRE_ALL_CHANNELS=false

# CTA — leave blank to use lane-aware defaults.
# Thursday (reality-check lane) gets the soft podcast plug; all other days get the follow CTA.
# Set BLOTATO_NEWS_CTA to override all lanes with a single fixed CTA.
BLOTATO_NEWS_CTA=
BLOTATO_THURSDAY_PODCAST_PLUG=Turing's Torch AI Weekly is out every Friday — follow Jonathan Harris wherever you listen to podcasts.
BLOTATO_DEFAULT_FOLLOW_CTA=For straight-talking artificial intelligence analysis, keep Jonathan Harris on your radar.
BLOTATO_SCRIPT_MODEL=anthropic/claude-sonnet-4.6
BLOTATO_NEWS_RESPONSE_FORMAT_MODE=json_object
BLOTATO_STEP0_PREFLIGHT_ENABLED=true
BLOTATO_PREFLIGHT_REQUIRE_LISTED_ACCOUNTS=true
BLOTATO_PREFLIGHT_REQUIRE_LISTED_SUBACCOUNTS=true
BLOTATO_FACEBOOK_MEDIA_TYPE=reel
BLOTATO_KEEPALIVE_ENABLED=true
BLOTATO_KEEPALIVE_INTERVAL_MS=20000
BLOTATO_PUBLISH_SEQUENTIAL=true
BLOTATO_PUBLISH_STAGGER_MS=2500
BLOTATO_SCRIPT_TIMEOUT_MS=120000


