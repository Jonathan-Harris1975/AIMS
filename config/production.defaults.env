# =============================================================================
# AIMS — Production Non-Secret Defaults
# =============================================================================
# Keep ALL credentials, API keys, and tokens out of this file.
# Koyeb secrets provide those at runtime.
# Values here are loaded only when the same key is NOT already in process.env.
# Local .env overrides these defaults but never overrides Koyeb secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# CORE SERVER
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_TITLE=AI Management Suite
APP_URL=https://zeroth-kara-jonathanharris-3296ed37.koyeb.app
SITE_BASE_URL=https://jonathan-harris.online
SITE_SHELL_MANIFEST_URL=https://jonathan-harris.online/assets/site-shell/manifest.json
SITE_SHELL_ALLOWED_HOSTS=jonathan-harris.online
SITE_SHELL_SYNC_SHARED_SECRET=
INTERNAL_BASE_HOST=127.0.0.1
INTERNAL_BASE_PROTO=http
INTERNAL_ROUTE_TIMEOUT_MS=60000
LOG_LEVEL=info
DEBUG_ROUTES=false
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb
SHUTDOWN_TIMEOUT_MS=10000
BOOTSTRAP_STEP_TIMEOUT_MS=120000
AUTO_CALL=yes


# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000

# Public destructive/publishing hooks stay closed in production unless deliberately reopened.
CLOUDFLARE_PURGE_ALLOW_PUBLIC=false
BLOTATO_ALLOW_PUBLIC_PUBLISH_HOOKS=false


# -----------------------------------------------------------------------------
# AI MODELS (OpenRouter)
# -----------------------------------------------------------------------------
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=AI Management Suite
OPENROUTER_SITE_URL=https://zeroth-kara-jonathanharris-3296ed37.koyeb.app
OPENROUTER_SERVICE_TIER=auto
OPENROUTER_SORT_BY=price
OPENROUTER_ENABLE_FALLBACKS=true
OPENROUTER_REQUIRE_PARAMETERS_FOR_JSON=true

# Model aliases — change here to swap models across the whole suite
OPENROUTER_ANTHROPIC_4_6=anthropic/claude-sonnet-4.6
OPENROUTER_CLAUDE_SONNET_5=anthropic/claude-sonnet-4.6
OPENROUTER_CLAUDE_OPUS_4_7=anthropic/claude-opus-4.7
OPENROUTER_GPT_5_6_SOL=openai/gpt-5.6-sol
OPENROUTER_GOOGLE_2_5_flashlite=google/gemini-2.5-flash-lite
OPENROUTER_META=meta-llama/llama-4-scout
OPENROUTER_ART=bytedance-seed/seedream-4.5
OPENROUTER_ART_BACKUP=black-forest-labs/flux.2-pro

# Default model slots
AI_MODEL_STANDARD=anthropic/claude-sonnet-4.6
AI_MODEL_FAST=google/gemini-2.5-flash-lite
AI_MODEL_HIGH_QUALITY=anthropic/claude-sonnet-4.6
AI_MODEL_AUDIT=anthropic/claude-sonnet-4.6
AI_MODEL_FALLBACK=openai/gpt-5.6-sol
AI_MODEL_JSON=anthropic/claude-sonnet-4.6
AI_MODEL_SUMMARY=google/gemini-2.5-flash-lite
AI_MODEL_IMAGE=bytedance-seed/seedream-4.5

# AI request defaults
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.65
AI_TOP_P=0.9
AI_TIMEOUT=90000
AI_MAX_RETRIES=4
AI_RETRY_BASE_MS=750
# Empty visible completions fail over quickly instead of burning the full per-provider retry budget.
AI_EMPTY_COMPLETION_RETRIES_PER_PROVIDER=1
AI_USAGE_LOG_ENABLED=true

# Headroom context compression. Enable only when HEADROOM_BASE_URL points to a deployed
# Headroom proxy exposing /v1/compress. OpenRouter image traffic is never redirected.
HEADROOM_ENABLED=false
HEADROOM_BASE_URL=
HEADROOM_API_KEY=
HEADROOM_PROXY_TOKEN=
HEADROOM_TIMEOUT_MS=5000
HEADROOM_MIN_INPUT_CHARS=2000
HEADROOM_TARGET_RATIO=0.7
HEADROOM_PROTECT_RECENT=0
HEADROOM_COMPRESS_USER_MESSAGES=true
HEADROOM_LOG_SAVINGS=true
HEADROOM_ROUTES=compose,scriptMain,scriptMainSynthesis,editorialPass,editAndFormat,rssRewrite,blogWeekly,blogSocial,onBrandAudit,auditForensic,zernioDaily,zernioMiniSeriesResearch,zernioMiniSeriesTheme,zernioMiniSeriesPost,zernioEbook,blotatoNewsShort,newsletterCompose,newsletterFactCheck,newsletterVoiceReview,newsletterAudienceReview,newsletterCouncilChair

# Podcast long-form model output budgets
PODCAST_SYNTHESIS_MAX_TOKENS=24000
PODCAST_SYNTHESIS_TIMEOUT_MS=900000
PODCAST_EDITORIAL_MAX_TOKENS=32000
PODCAST_EDITORIAL_TIMEOUT_MS=900000
PODCAST_REPAIR_MAX_TOKENS=16000
PODCAST_REPAIR_TIMEOUT_MS=900000
PODCAST_SYNTHESIS_REASONING_EFFORT=low
PODCAST_EDITORIAL_REASONING_EFFORT=none
PODCAST_REPAIR_REASONING_EFFORT=none


# -----------------------------------------------------------------------------
# RETRY & BACKOFF
# -----------------------------------------------------------------------------
RETRY_DELAY_MS=2500
RETRY_BACKOFF_MULTIPLIER=2
MAX_CHUNK_RETRIES=3


