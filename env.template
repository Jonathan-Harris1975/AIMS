# ------------------------------------------------------------------
# RSS Links (URL Shortener)
# ------------------------------------------------------------------
# Base URL used when building the short_url in API responses.
# Leave blank to fall back to APP_URL (recommended until you have a custom domain).
# Once a custom domain is set up, set this to the root of that domain,
# e.g. RSS_LINKS_BASE_URL=https://links.yoursite.com
RSS_LINKS_BASE_URL=

# Path prefix appended to RSS_LINKS_BASE_URL when constructing short URLs.
# Defaults to /rss-links when running under the suite.
# Set to empty string ("") once you're using a dedicated custom domain.
RSS_LINKS_PATH_PREFIX=/rss-links

# Set to "false" to allow duplicate short codes for the same long URL.
# Default is "true" (same long URL always returns the same short code).
RSS_LINKS_UNIQUE=true

# ------------------------------------------------------------------
# SEO + AEO + GEO forensic audit AI provider configuration
# Uses the shared OpenRouter settings above. Audit routes prefer AI_MODEL_AUDIT,
# then fall back through the canonical model variables already declared above.
# ------------------------------------------------------------------
# Backward-compatible model aliases accepted by ai-config.js.
OPENROUTER_ANTHROPIC=
OPENROUTER_GOOGLE=
OPENROUTER_CHATGPT=
OPENROUTER_DEEPSEEK=

# Legacy provider-specific key names are optional only. Prefer OPENROUTER_API_KEY.
OPENROUTER_API_KEY_ANTHROPIC=
OPENROUTER_API_KEY_GOOGLE=
OPENROUTER_API_KEY_CHATGPT=
OPENROUTER_API_KEY_DEEPSEEK=
OPENROUTER_API_KEY_META=

# Audit-specific controls override the general AI_* values so the forensic
# route does not inherit short podcast/script limits or retry storms.
AUDIT_AI_MAX_TOKENS=9000
AUDIT_AI_TIMEOUT_MS=240000
AUDIT_AI_MAX_RETRIES=0
AUDIT_AI_RETRY_BASE_MS=500
AUDIT_AI_TEMPERATURE=0.15
AUDIT_AI_TOP_P=0.95
AUDIT_ANALYSIS_MAX_WAIT_SECONDS=900

# ------------------------------------------------------------------
# Audit webhook / GitHub dispatch (REQUIRED — deployment-check.js enforces these)
# All four must be set in Koyeb (or your deployment env) or the container
# will exit at startup with "Missing required ENV variables".
# ------------------------------------------------------------------
# Secret token that the audit callback webhook validates on inbound requests.
AUDIT_CALLBACK_TOKEN=
# GitHub repo owner (username or org) that receives audit dispatch events.
AUDIT_WEBSITE_REPO_OWNER=
# GitHub repo name that receives audit dispatch events.
AUDIT_WEBSITE_REPO_NAME=
# GitHub personal-access token (or fine-grained token) with repo:dispatch scope.
GITHUB_TOKEN_WEBSITE_AUDITS=

# ------------------------------------------------------------------
# Brand assets R2 bucket (REQUIRED — deployment-check.js enforces these)
# ------------------------------------------------------------------
R2_BUCKET_BRAND_ASSETS=
R2_PUBLIC_BASE_URL_BRAND_ASSETS=

# ------------------------------------------------------------------
# Durable state note (ALLOW_EPHEMERAL_STATE is set above in the Core section)
# With NODE_ENV=production the startup check throws if R2_ENDPOINT,
# R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, and at least one of the
# R2_BUCKET_META* vars are not set.
# Set ALLOW_EPHEMERAL_STATE=true ONLY to unblock a test deployment where
# state loss across restarts is acceptable.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Phase 3 autonomous content publishing gates
# ------------------------------------------------------------------
