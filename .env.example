# Unified prompts/conversation intelligence stay off until all channels are connected.
COMMS_HUB_EMAIL_WORKFLOW_EVALUATION_ENABLED=false

COMMS_HUB_CHAT_ENABLED=false
COMMS_HUB_CHAT_FORCE_DISABLED=false
COMMS_HUB_COGINPAL_API_BASE_URL=
COMMS_HUB_COGINPAL_API_KEY=
COMMS_HUB_COGINPAL_WEBHOOK_SECRET=
COMMS_HUB_COGINPAL_TIMEOUT_MS=15000
COMMS_HUB_WEBHOOK_SIGNATURE_MAX_AGE_MS=300000


COMMS_HUB_ATTACHMENT_MAX_BYTES=20971520
COMMS_HUB_ATTACHMENT_DOWNLOAD_TIMEOUT_MS=30000
COMMS_HUB_ATTACHMENT_SCANNER_URL=https://api.cloudmersive.com/virus/scan/file
COMMS_HUB_ATTACHMENT_SCANNER_TOKEN=
COMMS_HUB_ATTACHMENT_SCAN_TIMEOUT_MS=30000

COMMS_HUB_RBAC_DELEGATION_SECRET=
COMMS_HUB_RBAC_SIGNATURE_MAX_AGE_MS=300000
COMMS_HUB_SUITE_ROLE=admin

COMMS_HUB_DELAYED_ACTION_WORKER_ENABLED=true
COMMS_HUB_DELAYED_ACTION_POLL_MS=60000
COMMS_HUB_DELAYED_ACTION_LEASE_MS=180000
COMMS_HUB_DELAYED_ACTION_BATCH_SIZE=20
COMMS_HUB_RETENTION_WORKER_ENABLED=false
COMMS_HUB_RETENTION_POLL_MS=86400000
COMMS_HUB_RETENTION_BATCH_SIZE=50
COMMS_HUB_MONTH_END_ARCHIVE_ENABLED=true
COMMS_HUB_MONTH_END_ARCHIVE_POLL_MS=21600000
COMMS_HUB_MONTH_END_ARCHIVE_BATCH_SIZE=100
COMMS_HUB_AUTONOMOUS_REPLIES_ENABLED=false

COMMS_HUB_CREDENTIAL_VAULT_ENABLED=false
COMMS_HUB_CREDENTIAL_MASTER_KEY=
COMMS_HUB_OAUTH_ALLOWED_SCOPES=
COMMS_HUB_NOTIFICATION_EMAIL_MAP={}
COMMS_HUB_NOTIFICATION_DEFAULT_EMAIL=


# Operation gates
AIMS_OPERATION_NEWSLETTER_ENABLED=true

COMMS_HUB_ATTACHMENT_SCANNER_PROVIDER=cloudmersive

# Comms Hub Smart Conduct + Memory Layer
COMMS_HUB_SMART_CONTEXT_ENABLED=true
COMMS_HUB_SMART_MAX_BOOK_CANDIDATES=3
COMMS_HUB_SMART_LIVE_CONTENT_ENABLED=true
COMMS_HUB_SMART_LIVE_CONTENT_MAX_ITEMS=4
COMMS_HUB_SMART_STRATEGY_ENABLED=true
COMMS_HUB_SMART_RESPONSE_ENABLED=true
COMMS_HUB_SMART_RESPONSE_MIN_CONFIDENCE=0.86
COMMS_HUB_FORM_ORCHESTRATION_ENABLED=true
COMMS_HUB_FORM_SMART_PROCESSING_ENABLED=true
# Keep automatic processed-form email replies off until the live canary/approval gate is accepted.
COMMS_HUB_FORM_AUTO_SEND_ENABLED=false
COMMS_HUB_BUSINESS_TIMEZONE=Europe/London
COMMS_HUB_BUSINESS_START_HOUR=9
COMMS_HUB_BUSINESS_END_HOUR=17
COMMS_HUB_EMAIL_INITIAL_REPLY_DELAY_ENABLED=true
COMMS_HUB_FORM_REPLY_DELAY_ENABLED=true
# First substantive AIMS reply: 2-3 calendar days; weekend targets roll to Monday.
COMMS_HUB_REPLY_DELAY_MIN_DAYS=2
COMMS_HUB_REPLY_DELAY_MAX_DAYS=3
COMMS_HUB_HUMAN_HANDOFF_BUSINESS_HOURS_ONLY=true
COMMS_HUB_CALLBACK_EMAIL_CAPTURE_ENABLED=true
COMMS_HUB_FORM_REQUEST_EXPIRY_HOURS=336
COMMS_HUB_JOTFORM_CONTACT_URL=https://form.jotform.com/260281179574362
COMMS_HUB_JOTFORM_CASE_STUDY_URL=https://form.jotform.com/262063136008044
COMMS_HUB_JOTFORM_PODCAST_URL=https://form.jotform.com/262097861889073
COMMS_HUB_SMART_CONDUCT_ENABLED=true
COMMS_HUB_BAD_LANGUAGE_BLOCK_ENABLED=true
COMMS_HUB_CONDUCT_REVIEW_STRIKES=2
COMMS_HUB_CONDUCT_AUTOMATION_BLOCK_STRIKES=2
