# ------------------------------------------------------------------
# Durable state note (ALLOW_EPHEMERAL_STATE is set above in the Core section)
# With NODE_ENV=production the startup check throws if R2_ENDPOINT,
# R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, and at least one of the
# R2_BUCKET_META* vars are not set.
# Set ALLOW_EPHEMERAL_STATE=true ONLY to unblock a test deployment where
# state loss across restarts is acceptable.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Phase 3 autonomous content publishing gates
# ------------------------------------------------------------------
# Phase 3 is auto-review + auto-publish + fail-closed.
# Content that fails these gates is quarantined and is not published.
PHASE3_AUTOPUBLISH_MIN_SCORE=85
PHASE3_SOURCE_MIN_CHARS=180
PHASE3_MAX_SENTENCE_WORDS=34
PHASE3_MAX_PODCAST_SENTENCE_WORDS=26


# -----------------------------------------------------------------------------
# Gate review councils, async Hookdeck routes, and retry hardening
# -----------------------------------------------------------------------------
# Platform-wide floor: every retry/attempt knob defaults to at least this
# many total attempts before quarantine/QA failure (config/thresholds.js).
