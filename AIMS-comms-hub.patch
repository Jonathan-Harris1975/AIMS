+  assert.equal(database.prepare("SELECT COUNT(*) AS count FROM comms_hub_contacts").get().count, 1);
+  assert.equal(database.prepare("SELECT COUNT(*) AS count FROM comms_hub_conversations").get().count, 1);
+  assert.equal(database.prepare("SELECT COUNT(*) AS count FROM comms_hub_messages").get().count, 1);
+  assert.equal(database.prepare("SELECT COUNT(*) AS count FROM comms_hub_attachments").get().count, 1);
+  assert.equal(database.prepare("SELECT COUNT(*) AS count FROM comms_hub_intake_events").get().count, 1);
+
+  const conversation = await repository.getConversation(intake.conversationId);
+  assert.equal(conversation.contact.primary_email, "grace@example.com");
+  assert.equal(conversation.messages.length, 1);
+  assert.equal(conversation.attachments.length, 1);
+});
+
+test("archive queue uses a lease so two AIMS instances cannot claim the same event", async () => {
+  const { repository } = await setup();
+  const intake = intakeFixture();
+  await repository.persistJotformIntake(intake);
+  const now = "2026-07-30T21:11:00.000Z";
+  const first = await repository.claimArchiveJob({ workerId: "worker-a", now, leaseExpiresAt: "2026-07-30T21:13:00.000Z", maxAttempts: 10 });
+  const second = await repository.claimArchiveJob({ workerId: "worker-b", now, leaseExpiresAt: "2026-07-30T21:13:00.000Z", maxAttempts: 10 });
+  assert.equal(first.event_id, intake.eventId);
+  assert.equal(second, null);
+  await repository.completeArchiveJob({ eventId: intake.eventId, workerId: "worker-a", completedAt: "2026-07-30T21:12:00.000Z" });
+  await repository.completeArchiveJob({ eventId: intake.eventId, workerId: "worker-a", completedAt: "2026-07-30T21:12:30.000Z" });
+  assert.deepEqual(await repository.getArchiveCounts(), { complete: 1 });
+});
